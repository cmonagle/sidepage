{
    "manifest_version": 2,
    "name": "Sidepage",
    "version": "{{version}}",
    "description": "{{description}}",
    "icons": {
      "48": "side-view.png",
      "96": "side-view.png"
    },
    "author": "{{{author}}}",
    "homepage_url": "{{{homepage}}}",
    "browser_specific_settings": {
      "gecko": {
        "id": "sidepage@cameronmonagle.com",
        "strict_min_version": "62.0"
      }
    },
    "background": {
      "scripts": [
        "build/buildSettings.js",
        "background.js"
      ]
    },
    "browser_action": {
      "default_icon": "side-view.svg",
      "default_title": "Open Side View"
    },
    "sidebar_action": {
      "default_icon": "side-view.svg",
      "default_title": "Side View",
      "default_panel": "sidebar.html"
    },
    "options_ui": {
      "page": "options.html",
      "open_in_tab": true
    },
    "permissions": [
      "storage"
    ]
  }
